#!/usr/bin/env bash
set -eu

if [ "$#" -ne 2 ]; then
    printf 'Usage: mema_verify <file> <sha256>\n' >&2
    exit 2
fi

file="$1"
expected_sha="$2"
case "$expected_sha" in
    *[!0123456789abcdefABCDEF]*|'') printf 'Mema: SHA-256 must be exactly 64 hexadecimal characters\n' >&2; exit 1 ;;
    ????????????????????????????????????????????????????????????????) ;;
    *) printf 'Mema: SHA-256 must be exactly 64 hexadecimal characters\n' >&2; exit 1 ;;
esac
[ -f "$file" ] || { printf 'Mema: file not found: %s\n' "$file" >&2; exit 1; }
printf '%s  %s\n' "$expected_sha" "$file" | sha256sum -c - >/dev/null
